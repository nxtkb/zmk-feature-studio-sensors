# Reject saved bindings when firmware-owned behavior semantics may have changed.
function(ss_storage_signature output)
  get_filename_component(module_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  set(module_dirs ${ZMK_EXTRA_MODULES} "${module_root}")
  foreach(name IN LISTS ZEPHYR_MODULE_NAMES)
    string(TOUPPER "${name}" module_id)
    string(REGEX REPLACE "[^A-Z0-9_]" "_" module_id "${module_id}")
    list(APPEND module_dirs "${ZEPHYR_${module_id}_MODULE_DIR}")
  endforeach()
  list(REMOVE_DUPLICATES module_dirs)

  file(GLOB_RECURSE sources CONFIGURE_DEPENDS
    "${APPLICATION_SOURCE_DIR}/src/behaviors/*.c" "${APPLICATION_SOURCE_DIR}/src/behaviors/*.h")
  foreach(directory IN LISTS module_dirs)
    if(NOT IS_DIRECTORY "${directory}")
      continue()
    endif()
    file(GLOB_RECURSE module_sources CONFIGURE_DEPENDS "${directory}/src/*.c" "${directory}/include/*.h")
    list(APPEND sources ${module_sources})
  endforeach()
  set(canonical_sources "")
  foreach(source IN LISTS sources)
    file(REAL_PATH "${source}" canonical)
    list(APPEND canonical_sources "${canonical}")
  endforeach()
  list(REMOVE_DUPLICATES canonical_sources)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${canonical_sources})
  set(source_hashes "")
  foreach(source IN LISTS canonical_sources)
    file(SHA256 "${source}" hash)
    list(APPEND source_hashes "${hash}")
  endforeach()
  # Workspace paths and module discovery order are not firmware semantics.
  list(SORT source_hashes)
  set(inputs "${PROJECT_BINARY_DIR}/zephyr.dts"
    "${PROJECT_BINARY_DIR}/include/generated/zephyr/autoconf.h"
    "${module_root}/protocol/local/sensors.proto")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs})
  foreach(input IN LISTS inputs)
    file(SHA256 "${input}" hash)
    string(APPEND source_hashes ":${hash}")
  endforeach()
  string(SHA256 hash "${source_hashes}:storage-v1")
  set(signature "")
  foreach(index RANGE 0 15)
    math(EXPR offset "${index} * 2")
    string(SUBSTRING "${hash}" ${offset} 2 octet)
    string(APPEND signature "0x${octet},")
  endforeach()
  set(${output} "${signature}" PARENT_SCOPE)
endfunction()
