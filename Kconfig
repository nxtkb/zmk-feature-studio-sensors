config NXTKB_STUDIO_SENSORS
    bool "Runtime Studio sensor bindings (NXTKB extension 0.1)"
    depends on ZMK_STUDIO_RPC
    help
      Enables runtime sensor editing for compatible clients. Requires this
      module's pinned integration patches; this is not an upstream protocol.

config NXTKB_STUDIO_SENSORS_MAX_SENSORS
    int "Maximum runtime sensor slots"
    depends on NXTKB_STUDIO_SENSORS
    range 1 16
    default 4
