config NXTKB_STUDIO_SENSORS
    bool "Local experimental Studio sensor protocol 0.1"
    depends on ZMK_STUDIO_RPC
    help
      Enables the independent sensor service for local testing. Requires the
      matching integration patches. This is not an upstream wire allocation.

config NXTKB_STUDIO_SENSORS_MAX_SENSORS
    int "Maximum sensor slots allocated by the local backend"
    depends on NXTKB_STUDIO_SENSORS
    range 1 16
    default 4
