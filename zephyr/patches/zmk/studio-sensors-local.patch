+/* Called at the sensor-event boundary, never concurrently from the RPC thread. */
+int zmk_behavior_sensor_rotate_common_reset(struct zmk_behavior_binding *binding,
+                                            struct zmk_behavior_binding_event event) {
+    const struct device *dev = zmk_behavior_get_binding(binding->behavior_dev);
+    struct behavior_sensor_rotate_data *data = dev->data;
+    int index = ZMK_SENSOR_POSITION_FROM_VIRTUAL_KEY_POSITION(event.position);
