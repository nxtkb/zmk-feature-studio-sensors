+        event.layer >= ZMK_KEYMAP_LAYERS_LEN)
+        return -EINVAL;
+    data->remainder[index][event.layer] = (struct sensor_value){0};
+    data->triggers[index][event.layer] = 0;
+    return 0;
+}
